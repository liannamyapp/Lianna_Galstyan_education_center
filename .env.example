# --- Required ---
# PostgreSQL connection string (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Public site URL, without trailing slash
NEXT_PUBLIC_SITE_URL="https://example.am"
# Random long string (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="galstyan.liana.87@gmail.com"
ADMIN_PASSWORD="change-me"

# --- Email (SMTP). Without it, emails are printed to the server log ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Լիաննա Գալստյան <no-reply@example.am>"

# --- Payments. Without credentials, the built-in test checkout is used ---
# Idram merchant
IDRAM_REC_ACCOUNT=""
IDRAM_SECRET_KEY=""
# Bank card via Ameriabank vPOS 3.1 (set AMERIA_TEST="false" in production)
AMERIA_CLIENT_ID=""
AMERIA_USERNAME=""
AMERIA_PASSWORD=""
AMERIA_TEST="true"

# --- Optional ---
# Vercel Blob token for image uploads (otherwise images are saved to /public/uploads, local dev only)
BLOB_READ_WRITE_TOKEN=""
# WhatsApp notifications to the admin via GREEN-API
GREEN_API_ID_INSTANCE=""
GREEN_API_TOKEN=""
GREEN_API_ADMIN_PHONE=""
# Instance host from the GREEN-API console ("apiUrl"), e.g. https://7107.api.greenapi.com
GREEN_API_URL=""
# Built-in test checkout (no real money). Set to "false" once Idram / bank contracts are live
ALLOW_TEST_PAYMENTS="true"
# Protects the daily automation (payment reminders, group statuses). Vercel Cron sends it automatically
CRON_SECRET="change-me-another-long-random-string"

# --- CRM (see docs/CRM.md and /admin/crm/settings) ---
# Incoming WhatsApp messages via GREEN-API webhook ("Webhook URL Token" in the GREEN-API console)
GREEN_API_WEBHOOK_TOKEN=""
# Telegram bot from @BotFather; secret is passed to setWebhook as secret_token
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Instagram Direct + Facebook Messenger (Meta app)
META_PAGE_TOKEN=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
# Key for POST /api/crm/lead (Zapier, Make, Lead Ads, external forms)
CRM_API_KEY=""
